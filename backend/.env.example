# Meshy Backend Environment Variables

# The active Meshy API key. Provide this to use the proxy without sending the key from the client.
# Keep this blank in development to rely on 'X-Meshy-Key' sent from the frontend.
MESHY_API_KEY=""

# The webhook secret used to verify incoming requests from Meshy to the /api/meshy/webhook endpoint.
# Set this to the secret provided in your Meshy webhook configuration.
MESHY_WEBHOOK_SECRET=""

# Cross Origin Resource Sharing limits. Defaults to the local vite server if unset.
CORS_ALLOW_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Download security limits
MAX_DOWNLOAD_BYTES=1073741824
ALLOWED_DOWNLOAD_HOSTS="assets.meshy.ai"

# Operational
HTTP_TIMEOUT_SECONDS=60
MESHY_MAX_RETRIES=3
